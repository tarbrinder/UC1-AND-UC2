# ─────────────────────────────────────────────────────────────────────────────
# .env template — copy to `.env` and fill from the secrets vault / project owner.
# `.env` is gitignored and MUST NOT be committed.
#
# Naming rule (Vite): a var prefixed `VITE_` is INLINED INTO THE BROWSER BUNDLE
# (client-visible — never put a server-only secret behind a VITE_ prefix unless
# it is genuinely meant to be public). A var WITHOUT the prefix is read only by
# vite.config.ts and injected SERVER-SIDE by the dev proxy (stays out of the bundle).
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (Gemini via the IndiaMART gateway) — REQUIRED ────────────────────────
# Bearer key for imllm.intermesh.net. Drives the buyer-profile extract LLM AND the
# fast-mode web engine (Gemini 2.5 Flash + Google Search grounding).
# ⚠ VITE_-prefixed → this key IS shipped to the browser (gemini.ts reads it directly).
# For anything beyond a debug tool, route LLM calls through a server proxy instead.
VITE_LLM_KEY=

# ── External enrichment vendors — injected SERVER-SIDE by the Vite proxy ─────
# (NOT VITE_-prefixed → never enter the browser bundle; the proxy adds the header.)
# Until set, the External Pull Health panel reports each source as creds-pending;
# the call path is fully wired and runs the moment keys land.
BEFISC_AUTHKEY=          # Befisc KYB — proxy header `authkey` on /api/smartauth
SIGN3_BEARER=            # Sign3 identity/trust — proxy `Authorization: Bearer` on /api/sign3
FIRECRAWL_API_KEY=       # Firecrawl web search — proxy Bearer on /api/firecrawl  (optional)

# ── Vendor endpoint URLs (client-side, non-secret) ───────────────────────────
VITE_BEFISC_PROFILE_ENDPOINT=   # Befisc Profile-Advance endpoint CODE (mobile → identity/company; "C9S1")
VITE_SIGN3_ENDPOINT=            # Sign3 endpoint URL/path (mobile → identity/social)

# ── Langfuse observability — OPTIONAL (the app runs fine without these) ───────
VITE_LANGFUSE_PUBLIC_KEY=
VITE_LANGFUSE_SECRET_KEY=
VITE_LANGFUSE_HOST=

# ── n8n backend (for reference — not an env var) ─────────────────────────────
# The enrichment pulls hit an n8n webhook, path `bi-user-insights-v10x`, imported
# separately from the owner's workflow JSON (kept out of git — it holds plaintext keys).
# Fast pull: append `&fast=1` (skips transcription + Parallel; uses Gemini grounded web).
