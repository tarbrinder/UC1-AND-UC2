# IndiaMART LLM gateway key (required for voice / image / spec-hint AI features)
VITE_LLM_KEY=your-llm-key-here

# Optional: origin to prefix all /api/* calls with.
# Leave empty for local dev (the Vite proxy in vite.config.ts handles routing).
# Set to the gateway origin when deploying or embedding in the IndiaMART shell,
# e.g. VITE_API_BASE=https://gateway.indiamart.com
VITE_API_BASE=

# ── E: External enrichment (Befisc · Sign3) — Part C ──────────────────────────
# Until these are set, the External Pull Health panel reports each source as
# 'creds_pending' (the call path is fully wired; it runs the moment keys land).
# Befisc/Sign3 are called through the same-origin /api/smartauth Vite proxy (CORS-safe).
#
# Befisc smartauth authkey (header `authkey`) + the Profile-Advance endpoint CODE
# (mobile → identity/company; the shared docs call this C9S1). GST/HSN/Udyam codes
# are DEFERRED — that chain is intentionally not run yet.
VITE_BEFISC_AUTHKEY=
VITE_BEFISC_PROFILE_ENDPOINT=
# Sign3 (mobile → identity/social) — full endpoint URL/path + Bearer token.
VITE_SIGN3_ENDPOINT=
VITE_SIGN3_BEARER=
# Optional: override the same-origin proxy base for Befisc/Sign3 (default /api/smartauth).
VITE_EXTERNAL_PROXY_BASE=
